{
  "name": "@secureassess/student-kiosk",
  "homepage": "https://github.com/VenkataSai-cruzer/Proctify",
  "version": "1.2.0",
  "description": "SecureAssess Student Kiosk — Secure exam client with OS-level lockdown",
  "author": "SecureAssess <admin@secureassess.local>",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node ../../scripts/build-electron.mjs . && concurrently \"vite\" \"wait-on http://localhost:5174 && electron .\"",
    "dev:renderer": "vite --port 5174",
    "build:main": "node ../../scripts/build-electron.mjs .",
    "build": "node ../../scripts/build-electron.mjs . && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "package:win": "electron-builder --config electron-builder.yml --win",
    "package:linux": "electron-builder --config electron-builder.yml --linux",
    "package:all": "electron-builder --config electron-builder.yml --win --linux"
  },
  "dependencies": {
    "@secureassess/shared": "workspace:*",
    "@sentry/electron": "^5.4.0",
    "clsx": "^2.1.1",
    "electron-updater": "^6.3.4",
    "framer-motion": "^11.2.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.1",
    "socket.io-client": "^4.7.5",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "clsx": "^2.1.1",
    "concurrently": "^8.2.2",
    "electron": "31.7.7",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.2",
    "framer-motion": "^11.2.13",
    "lucide-react": "^0.400.0",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.24.1",
    "tailwind-merge": "^2.4.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vite-plugin-electron": "^0.28.7",
    "wait-on": "^7.2.0",
    "zustand": "^4.5.4"
  },
  "build": {
    "appId": "com.proctify.student",
    "productName": "Proctify Student Kiosk",
    "copyright": "Copyright © 2024 Proctify",
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Education"
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true
    }
  }
}
