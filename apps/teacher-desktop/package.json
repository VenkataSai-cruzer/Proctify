{
  "name": "@secureassess/teacher-desktop",
  "homepage": "https://github.com/VenkataSai-cruzer/Proctify",
  "version": "1.0.1",
  "description": "SecureAssess Teacher Desktop — Exam management and live proctoring console",
  "author": "SecureAssess <admin@secureassess.local>",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:renderer": "vite",
    "dev:main": "tsc --project tsconfig.main.json --watch",
    "build": "tsc --project tsconfig.main.json && vite build",
    "package:win": "electron-builder --config electron-builder.yml --win",
    "package:linux": "electron-builder --config electron-builder.yml --linux",
    "package:all": "electron-builder --config electron-builder.yml --win --linux"
  },
  "dependencies": {
    "@electron/fuses": "^1.8.0",
    "@secureassess/shared": "workspace:*",
    "@sentry/electron": "^5.4.0",
    "@tanstack/react-query": "^5.50.1",
    "archiver": "^7.0.1",
    "bonjour-service": "^1.2.1",
    "clsx": "^2.1.1",
    "electron-store": "8.2.0",
    "electron-updater": "^6.3.4",
    "framer-motion": "^11.2.13",
    "jszip": "^3.10.1",
    "lucide-react": "^0.400.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.24.1",
    "recharts": "^2.12.7",
    "socket.io-client": "^4.7.5",
    "tailwind-merge": "^2.4.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.50.1",
    "@types/archiver": "^6.0.2",
    "@types/node": "^20.14.9",
    "@types/pdf-parse": "^1.1.4",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "clsx": "^2.1.1",
    "concurrently": "^8.2.2",
    "electron": "31.7.7",
    "electron-builder": "^24.13.3",
    "framer-motion": "^11.2.13",
    "lucide-react": "^0.400.0",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.24.1",
    "recharts": "^2.12.7",
    "socket.io-client": "^4.7.5",
    "tailwind-merge": "^2.4.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vite-plugin-electron": "^0.28.7",
    "wait-on": "^7.2.0",
    "zustand": "^4.5.4"
  },
  "build": {
    "appId": "com.secureassess.teacher",
    "productName": "SecureAssess Teacher",
    "copyright": "Copyright © 2024 SecureAssess",
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../../services/cctv-vision",
        "to": "cctv-vision",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Education"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
