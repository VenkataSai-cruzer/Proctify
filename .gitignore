# ── Dependencies ─────────────────────────────────────────────
node_modules/

# ── Build outputs ─────────────────────────────────────────────
dist/
build/
out/

# ── Electron packaging ────────────────────────────────────────
release/
dist-pyinstaller/
*.AppImage
*.deb
*.snap

# Windows installers — never committed
apps/teacher-desktop/release/
apps/student-kiosk/release/

# ── Secrets & environment ─────────────────────────────────────
.env
.env.local
*.local
encrypted-secrets.json

# ── Databases ────────────────────────────────────────────────
*.db
*.db-journal
*.db-shm
*.db-wal
# Keep .env.example files (they have no real secrets)
!.env.example

# ── Prisma migrations (generated) ────────────────────────────
# Keep migration files for reproducible deployments
# prisma/migrations/  ← intentionally not ignored

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/

# ── Test artifacts ────────────────────────────────────────────
apps/server/tmp-e2e-test*
exports/

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
venv/
services/cctv-vision/models/*.task
services/cctv-vision/models/*.tflite
services/cctv-vision/build/
services/cctv-vision/dist/

# ── Yarn Berry ────────────────────────────────────────────────
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
# Keep .yarn/releases (the berry binary itself)
!.yarn/releases

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Misc ─────────────────────────────────────────────────────
.turbo/
*.tsbuildinfo
