# Node server to connect to
SERVER_URL=http://localhost:3000
CCTV_SERVICE_SECRET=CHANGE_ME_cctv_internal_secret

# Camera source: "0" for first USB cam, "1" for second, or rtsp URL
CAMERA_SOURCE=0

# Head-pose thresholds (degrees)
YAW_THRESHOLD=30
PITCH_THRESHOLD=20
VIOLATION_DURATION_MS=4000

# Output frame resolution (downsized for performance)
FRAME_WIDTH=1280
FRAME_HEIGHT=720

# Frames per second for live feed broadcast
LIVE_FPS=5
